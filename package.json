{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:shared": "node --test shared/types.test.ts",
    "test:coverage": "npm run test:coverage -w client && npm run test:coverage -w server",
    "lint": "npm run lint --workspaces --if-present",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config e2e/playwright.config.ts",
    "test:perf": "playwright test --config e2e/playwright.perf.config.ts",
    "test:a11y": "playwright test --config e2e/playwright.config.ts e2e/tests/accessibility.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "1.59.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "lighthouse": "^13.1.0",
    "typescript": "^5.5.4"
  }
}
